```gitignore
# Dependencies
node_modules/

# Build output
dist/
build/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cache
.cache/
.parcel-cache/
.vite/

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Coverage reports
coverage/

# Temporary files
tmp/
temp/

# Package manager
.pnp
.pnp.js

# Optional lock files (keep if working in team)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
```
